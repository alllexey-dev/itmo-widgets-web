{
  "name": "itmo-widgets-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "DEMO=1 vite",
    "dev:demo:student": "DEMO=1 DEMO_ROLES= DEMO_PORT=5185 vite",
    "build": "vite build && vite build --ssr src/public/prerender.tsx --outDir node_modules/.cache/prerender --emptyOutDir && node node_modules/.cache/prerender/prerender.js",
    "preview": "vite preview",
    "preview:demo": "DEMO=1 vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "gen:api": "openapi-typescript src/app/api/openapi.json -o src/app/api/schema.ts",
    "astryx": "node node_modules/@astryxdesign/cli/clients/cli/bin/astryx.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@stylexjs/stylex": "0.19.2",
    "@tanstack/react-query": "5.107.1",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.16",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.2",
    "vitest": "5.0.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
